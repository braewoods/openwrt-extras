#!/bin/sh /etc/rc.common

START=99

USE_PROCD=1

start_service() {
	mkdir -p /var/tmp/iperf3
	chown network:network /var/tmp/iperf3
	procd_open_instance
	procd_set_param command /usr/bin/iperf3 -s -i 0
	procd_set_param env TMPDIR=/var/tmp/iperf3
	procd_set_param stdout 1
	procd_set_param stderr 1
	[ -x /sbin/ujail ] && {
		procd_add_jail iperf3 log
		procd_add_jail_mount_rw /var/tmp/iperf3
		procd_set_param user network
		procd_set_param group network
		procd_set_param no_new_privs 1
	}
	procd_close_instance
}
